Subject: [PATCH] Revert "codec2: Extend the queue empty work hack to MTK
 decoders too"

This reverts commit ebe138275f0a669cb5fca943a7a2066c8adb3783.
---
 media/codec2/sfplugin/CCodecBufferChannel.cpp | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/media/codec2/sfplugin/CCodecBufferChannel.cpp b/media/codec2/sfplugin/CCodecBufferChannel.cpp
index d26f2acc21..102b7b2b51 100644
--- a/media/codec2/sfplugin/CCodecBufferChannel.cpp
+++ b/media/codec2/sfplugin/CCodecBufferChannel.cpp
@@ -347,7 +347,7 @@ void CCodecBufferChannel::setComponent(
     std::atomic_store(&mComponent, component);
     mComponentName = component->getName() + StringPrintf("#%d", int(uintptr_t(component.get()) % 997));
     mName = mComponentName.c_str();
-    std::regex pattern{"c2\\.(mtk|qti)\\..*\\.decoder.*"};
+    std::regex pattern{"c2\\.qti\\..*\\.decoder.*"};
     mIsHWDecoder = std::regex_match(mComponentName, pattern);
 }
 
