From a5de669ec04b27021b98fba7899e5d2715e9b66f Mon Sep 17 00:00:00 2001
From: seriaTvT <63958697+seriaTvT@users.noreply.github.com>
Date: Fri, 24 Jul 2026 11:01:07 +0800
Subject: [PATCH] libutils: rate-limit RefBase explicit-destruction backtrace

RefBase::~RefBase() logs a full symbolized CallStack every time an object
is explicitly destroyed while its weak count is non-zero. Capturing that
stack unwinds and decompresses each frame's .gnu_debugdata (LZMA), which is
expensive. Vendor blobs that trip this on a hot path make it pathological:
MediaTek's libgpu_aux GuiExtAuxBufferQueue teardown, reached from
eglDestroyImageKHR once per rendered frame, pegs the GPU thread on stack
unwinding and causes severe UI stutter during media playback.

Emit the diagnostic backtrace at most once per process; the one-line ALOGW
still fires every time so the misuse stays visible.

Change-Id: I71152bb50356c53b1f6c42316e30e4a19495732a
---
 libutils/binder/RefBase.cpp | 14 +++++++++++++-
 1 file changed, 13 insertions(+), 1 deletion(-)

diff --git a/libutils/binder/RefBase.cpp b/libutils/binder/RefBase.cpp
index 7510aa2357..7fe06fa99f 100644
--- a/libutils/binder/RefBase.cpp
+++ b/libutils/binder/RefBase.cpp
@@ -17,6 +17,7 @@
 #define LOG_TAG "RefBase"
 // #define LOG_NDEBUG 0
 
+#include <atomic>
 #include <memory>
 #include <mutex>
 
@@ -802,7 +803,18 @@ RefBase::~RefBase()
                   mRefs->mWeak.load(), this);
 
 #if ANDROID_UTILS_CALLSTACK_ENABLED
-            CallStack::logStack(LOG_TAG);
+            // Capturing this backtrace is expensive: CallStack::logStack() unwinds and
+            // symbolizes, which decompresses each frame's .gnu_debugdata (LZMA) via
+            // unwindstack. Some vendor blobs trip this warning on a per-frame hot path
+            // (e.g. MediaTek libgpu_aux's GuiExtAuxBufferQueue teardown, reached from
+            // eglDestroyImageKHR once per rendered frame), which pegs the calling thread
+            // on stack unwinding and starves rendering. Emit the diagnostic stack at most
+            // once per process so the culprit is still recorded without the per-call cost;
+            // the ALOGW above still fires every time.
+            static std::atomic<bool> sLoggedExplicitDestruction(false);
+            if (!sLoggedExplicitDestruction.exchange(true, std::memory_order_relaxed)) {
+                CallStack::logStack(LOG_TAG);
+            }
 #endif
         } else if (strongs != 0) {
             LOG_ALWAYS_FATAL("RefBase: object %p with strong count %d deleted. Double owned?", this,
-- 
